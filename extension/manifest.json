{
  "manifest_version": 3,
  "name": "VYRO — YouTube, TikTok & Reels + PiP",
  "version": "1.6.0",
  "minimum_chrome_version": "116",
  "commands": {
    "skip-short": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "Skip video YouTube/TikTok/Facebook Reels đang phát, kể cả trong PiP",
      "global": true
    }
  },
  "description": "Tự chuyển Shorts, TikTok, Reels; PiP riêng với controls và PiP gốc Chrome cho video YouTube thường.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/on-16.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "VYRO",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/on-16.png",
      "24": "icons/on-24.png",
      "32": "icons/on-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.tiktok.com/*",
        "https://tiktok.com/*",
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "tiktok.js",
        "facebook.js",
        "youtube-pip.js",
        "shortcut.js",
        "pip.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
